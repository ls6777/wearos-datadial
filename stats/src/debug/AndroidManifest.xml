<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: lets build.sh switch the fixed test values on and off.
     DUMP is held by the adb shell, not by apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".TestValuesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
